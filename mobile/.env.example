# Base URL of the Orbit REST API, including /api. EXPO_PUBLIC_ values are embedded in the
# app bundle at build time, so never put secrets here.
#
# Leave unset during development with Expo Go: the app then calls port 4000 on the machine
# that runs Metro (the dev server). Set it to the deployed HTTPS API for release builds.
# Android emulator talking to a local API: http://10.0.2.2:4000/api
EXPO_PUBLIC_API_URL=
