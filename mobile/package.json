{
  "name": "orbit-pms-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android client (React Native + Expo) for the Orbit project management system.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "axios": "1.20.0",
    "expo": "57.0.27",
    "expo-asset": "57.0.19",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "babel-preset-expo": "57.0.14",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0"
  },
  "jest": {
    "preset": "jest-expo/android",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ]
  }
}
