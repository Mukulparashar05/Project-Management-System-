# Runtime environment: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/orbit_pms?schema=public"

# Separate database used only by the automated test suite (its name must end in _test)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/orbit_pms_test?schema=public"

# JWT signing secret: at least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# Token lifetime (number + s/m/h/d), e.g. 15m, 12h, 1d
JWT_EXPIRES_IN=1d

# Comma-separated list of browser origins allowed by CORS (your deployed web app URL in production)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku, 0 locally)
TRUST_PROXY=0

# Failed login/register attempts allowed per IP per window
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# General API requests allowed per IP per 15 minutes
API_RATE_LIMIT_MAX=300

# bcrypt cost factor (10-15 in production)
BCRYPT_SALT_ROUNDS=12
