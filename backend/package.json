{
  "name": "orbit-pms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Orbit project management system (shared by web and mobile).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
